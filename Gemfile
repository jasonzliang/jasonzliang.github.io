# Local development only. GitHub Pages builds the site in the cloud and does
# NOT use this file's versions — it uses its own pinned `github-pages` gem set.
# This mirrors that environment so `bundle exec jekyll serve` matches production.
#
#   gem install bundler && bundle install
#   bundle exec jekyll serve       # preview at http://localhost:4000/blog/
#
# Requires Ruby >= 3.1 (the system Ruby 2.6 on this Mac is too old — use rbenv
# or Homebrew Ruby, or just push and let GitHub Pages build it).

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"   # needed for `jekyll serve` on Ruby 3+
